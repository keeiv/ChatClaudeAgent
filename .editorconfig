# Editors and AI tools: the same whitespace rules as tools/check_style.py.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cpp,hpp,h,py}]
indent_size = 4

[*.{js,cjs,mjs,css,html,json,svg,md,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown; CCA's docs do not use them.
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
# Windows PowerShell 5.1 reads a file without a BOM in the ANSI code page.
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
